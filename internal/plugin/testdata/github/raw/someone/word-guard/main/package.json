{
  "name": "@agentlink-community/middleware-word-guard",
  "version": "0.1.1",
  "description": "New API's sensitive-word filter (敏感词过滤) as agentlink gateway middleware: turn away or mask words and patterns in what agents send, and in replies",
  "type": "module",
  "files": ["word-guard.middleware.js", "README.md"],
  "keywords": ["agentlink", "agentlink-middleware", "new-api", "sensitive-words", "guardrails", "llm-gateway"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/agentlink-community/plugins.git", "directory": "packages/word-guard" },
  "agentlink": {
    "middleware": "./word-guard.middleware.js",
    "options": { "words": ["project-codename"], "patterns": [], "action": "reject", "check": "last" }
  }
}
